{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and statistics",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "avatar": { "type": "string" },
        "superpower": { "type": "string" },
        "bio": { "type": "string" },
        "points": { "type": "number" },
        "streak": { "type": "number" },
        "tasksCompleted": { "type": "number" },
        "badges": { "type": "array", "items": { "$ref": "Badge" } }
      },
      "required": ["uid"]
    },
    "Badge": {
      "title": "Badge",
      "description": "Earned badge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "unlocked": { "type": "boolean" },
        "unlockedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Task": {
      "title": "Task",
      "description": "A single study task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "completed": { "type": "boolean" },
        "estimatedTime": { "type": "number" }
      }
    },
    "StudyLog": {
      "title": "StudyLog",
      "description": "Log of a study session",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskTitle": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "distractionCount": { "type": "number" },
        "completed": { "type": "boolean" }
      }
    },
    "GlossaryItem": {
      "title": "GlossaryItem",
      "description": "Saved word and definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "word": { "type": "string" },
        "definition": { "type": "string" },
        "dateAdded": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "users/{userId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "User tasks for roadmap"
    },
    "users/{userId}/studyLogs/{logId}": {
      "schema": "StudyLog",
      "description": "Study logs for progress tracking"
    },
    "users/{userId}/glossary/{itemId}": {
      "schema": "GlossaryItem",
      "description": "Saved glossary items"
    }
  }
}
